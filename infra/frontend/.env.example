# 나의 우주 화면(Next.js) 환경변수. 값은 .env.local(로컬, gitignore) 또는 Vercel 설정에 넣는다.
# 백엔드 주소(로컬 · Docker는 http://localhost:8001)
NEXT_PUBLIC_API_BASE=http://localhost:8001
# Supabase 프로젝트 주소와 anon 키(공개용 키, 서비스 키는 절대 넣지 않음)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1이면 시험용 계정(이메일 · 비밀번호) 로그인 칸을 보인다. 로컬 Supabase에서만 1.
NEXT_PUBLIC_DEV_LOGIN=0
# 1이면 백엔드 없이 고정 가짜 데이터(가상 인물 하늘)로 동작한다. 로그인도 건너뛴다. 배포에서는 0.
NEXT_PUBLIC_MOCK=0
