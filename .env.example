# Upstage Console에서 발급한 키 (Studio 에이전트와 같은 조직)
UPSTAGE_API_KEY=
# Studio 에이전트 ID와 설정 번호 (Studio 화면의 Code 버튼에서 확인)
RECORD_AGENT_ID=
RECORD_CONFIG_ID=1
OBSERVE_AGENT_ID=
OBSERVE_CONFIG_ID=1
# 선택: 공개 배포 보호
MAX_JOBS_PER_SESSION=40
MAX_IMPORT_POSTS=10
# 로컬 개발에서만 1 (추출 결과를 디스크에 캐시)
DISK_CACHE=0

# ---------- v8 백엔드(FastAPI, main.py) ----------
# 로컬은 scripts/dev_up.sh 가 .env.local 에 채운다(로컬 Supabase · ChromaDB). 배포 값은 동규가 Vercel 설정에 넣는다.
# Studio 설정 번호(새 백엔드 전용, 위의 RECORD_CONFIG_ID=1 은 Streamlit 데모용으로 그대로). 운영은 4판 = 기록 5 · 관측 4(2026-10-14), 비우면 코드 기본값 2
V8_RECORD_CONFIG_ID=5
V8_OBSERVE_CONFIG_ID=4
# Supabase: 프로젝트 주소 · anon 키(로그인 확인용), DB 연결 문자열(백엔드가 요청마다 그 사용자로 RLS 를 걺)
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
# 계정 지우기(DELETE /me)에서만 쓰는 service_role 키. 백엔드에만(화면 NEXT_PUBLIC_* 에는 절대 넣지 않음)
SUPABASE_SERVICE_ROLE_KEY=
# 쓸 수 있는 구글 계정 이메일(쉼표 목록). 비우면 로그인한 누구나(지금 배포는 비움 — docs/plan-v8-1017.md §2-9)
ALLOWED_EMAILS=
# 운영 화면 /ops 를 볼 운영자 구글 계정 이메일(쉼표 목록, WS22). 비우면 아무도 못 본다
ADMIN_EMAILS=
# 원문 암호화 마스터 키(base64 32바이트, `python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"`).
# 잃으면 저장된 일기를 못 연다. 바꾸면 예전 글을 못 연다.
DIARY_ENC_KEY=
# ChromaDB: 로컬 · Docker 는 HOST/PORT, 배포는 Chroma Cloud(API_KEY 가 있으면 Cloud 를 씀)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# 화면 주소(CORS 허용 하나)
FRONTEND_ORIGIN=http://localhost:3000
# 1 = logs/agent_flow_YYYYMMDD.log (로컬 · Docker), 0 = 표준 출력(Vercel)
LOG_TO_FILE=1
# 1 = /docs · /openapi.json 열기(로컬만). 배포는 넣지 않는다(꺼짐)
API_DOCS=0
# 운영 상한(사용자별 하루 글 수 · 이달 추정 비용 달러 · 기록당 '이어서 하기' 횟수). 비우거나 0이면 상한 없음
# (지금 배포는 넣지 않음 — 사용량 · 비즈니스 모델을 보고 나중에 정함, docs/plan-v8-1017.md §2-9)
DAILY_ENTRY_LIMIT=
MONTHLY_COST_CAP_USD=
RESUME_LIMIT=
MAX_TEXT_CHARS=8000
# 대화 초안(요약 확인 전)을 확인 없이 이 시간(시간 단위)만큼 두면 다음 요청 때 지운다(WS20). 0 = 지우지 않음. 사용 상한 아님
DRAFT_KEEP_HOURS=72
# 인스타 ZIP 가져오기 한 번에 고를 수 있는 최근 글 수. 비우면 상한 없음(기본, 결정 12 — 화면이 글 수 · 예상 시간 · 비용을 먼저 보임)
IMPORT_MAX_POSTS=
# 사진 글자 읽기(WS18) 모델: 비우면 document-parse(쪽당 $0.01, 2026-10-28 결정). ocr(쪽당 $0.0015)로 되돌릴 때만 넣는다
PHOTO_READ_MODEL=
# 말로 쓰기 · 읽어 주기(WS21, ElevenLabs — 받아쓰기 Scribe v2 · 읽어 주기). 키 권한은 Speech to Text · Text to Speech 만.
# 값은 동규가 ElevenLabs 에서 발급해 Vercel(백엔드) 설정에 넣는다. 비우면 말로 쓰기 · 읽어 주기는 503 voice_unconfigured
ELEVENLABS_API_KEY=
# 읽어 주기 목소리(ElevenLabs voice id, 비우면 기본 목소리) · 모델(비우면 받아쓰기 scribe_v2 · 읽어 주기 eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
# 한 번에 받는 녹음 조각(바이트, 입력 검사 · 상한 아님). Vercel 본문 한도 4.5MB 아래로 둔다 — 긴 녹음은 화면이 2분 조각으로 나눠 보냄
VOICE_MAX_BYTES=4194304
# 구글 로그인(로컬 Supabase 에서 시험할 때만, supabase/config.toml 의 [auth.external.google])
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
